{
  "identifier": "default",
  "description": "Default capabilities for Agent Window",
  "remote": {
    "urls": [
      "http://127.0.0.1:*",
      "http://localhost:*",
      "https://127.0.0.1:*",
      "https://localhost:*"
    ]
  },
  "windows": ["main"],
  "permissions": [
    "allow-open-external-url",
    "allow-show-chat-header-menu",
    "allow-show-appearance-menu",
    "allow-reset-window-geometry",
    "allow-compact-window-geometry",
    "allow-resize-window-from-edge",
    "allow-move-window-top",
    "allow-move-window-top-left",
    "allow-move-window-top-right",
    "allow-set-always-on-top",
    "allow-set-window-height",
    "allow-set-fit-height-min",
    "allow-show-session-switcher-menu",
    "allow-show-git-changes-menu",
    "allow-show-file-context-menu",
    "allow-show-session-context-menu",
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize"
  ]
}
